# ONE switch picks chain, RPC gateways, explorer and contract addresses:
#   mainnet → Arc mainnet (5042), v1.3 contracts, real USDC
#   testnet → Arc testnet (5042002), sandbox contracts
VITE_NETWORK=testnet
VITE_API_URL=http://localhost:8787

# Optional: dedicated RPC placed ahead of the public gateways
# VITE_RPC_URL=

# WalletConnect (mobile wallets)
VITE_WC_PROJECT_ID=
VITE_ENABLE_WC=1

# Circle Modular Wallets (passkey pay). TEST_ keys work only on testnet builds.
VITE_CIRCLE_CLIENT_KEY=
VITE_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Optional overrides — normally NOT needed (defaults come from VITE_NETWORK).
# IGNORED unless VITE_CONTRACT_OVERRIDES=1 is also set (prevents a dev .env leaking into prod builds):
# VITE_CONTRACT_OVERRIDES=1
# VITE_ROUTER_ADDRESS= VITE_NAMES_ADDRESS= VITE_SCHED_ADDRESS= VITE_SPLIT_ADDRESS= VITE_RECORDS_ADDRESS=
# VITE_NAMES_DEPLOY_BLOCK=
